AGING.stg_users\n)\n\nSELECT\n    user_id,\n    email,\n    mobile,\n\n    CASE\n        WHEN email IS NULL THEN 'NO_EMAIL'\n        ELSE 'HAS_EMAIL'\n    END AS email_status,\n\n    CASE\n        WHEN is_active = TRUE THEN 1\n        ELSE 0\n    END AS is_active_flag,\n\n    load_timestamp\n\nFROM stg", "relation_name": "BOOKSTORE_DW.INTERMEDIATE.int_users", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-18T07:10:39.788364Z", "completed_at": "2026-06-18T07:10:39.813250Z"}, {"name": "execute", "started_at": "2026-06-18T07:10:39.813250Z", "completed_at": "2026-06-18T07:10:40.114211Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.34229159355163574, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c5206e-000d-cb90-0000-95a1000a0122"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.bookstore.dim_users", "compiled": true, "compiled_code": "WITH int_users AS (\n\n    SELECT *\n    FROM BOOKSTORE_DW.INTERMEDIATE.int_users\n\n),\n\ndeduped AS (\n\n    SELECT *,\n           ROW_NUMBER() OVER (\n               PARTITION BY user_id\n               ORDER BY load_timestamp DESC\n           ) AS rn\n\n    FROM int_users\n\n)\n\nSELECT\n    user_id,\n    email,\n    mobile,\n    email_status,\n    is_active_flag,\n\n    CASE \n        WHEN is_active_flag = 1 AND email_status = 'HAS_EMAIL' THEN 'ACTIVE_COMPLETE'\n        WHEN is_active_flag = 1 THEN 'ACTIVE_INCOMPLETE'\n        ELSE 'INACTIVE'\n    END AS user_segment,\n\n    load_timestamp\n\nFROM deduped\nWHERE rn = 1", "relation_name": "BOOKSTORE_DW.MARTS.dim_users", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-18T07:10:38.669632Z", "completed_at": "2026-06-18T07:10:38.679178Z"}, {"name": "execute", "started_at": "2026-06-18T07:10:38.679178Z", "completed_at": "2026-06-18T07:10:41.933997Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 3.26