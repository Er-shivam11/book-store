@charset "utf-8";

.stylish_radio input[type="radio"] { appearance: none; inset: 0.33333px 0px 0px; height: 18px; width: 18px; transition: 0.15s ease-out; background: rgb(255, 255, 255); border: 2px solid rgb(5, 107, 195); color: rgb(255, 255, 255); cursor: pointer; display: inline-block; margin-right: 0.8rem; margin-left: 0.8rem; outline: none; position: relative; z-index: 10; }

.stylish_radio input[type="radio"]:hover { background: rgb(5, 107, 195); }

.stylish_radio input[type="radio"]:checked { background: rgb(5, 107, 195); }

.stylish_radio input[type="radio"]:checked::before { height: 15px; width: 15px; position: absolute; content: "âœ”"; display: inline-block; font-size: 14.6667px; text-align: center; line-height: 15px; font-weight: 400; }

.stylish_radio input[type="radio"]:checked::after { animation: 0.65s ease 0s 1 normal none running click-wave; background: rgb(64, 224, 208); content: ""; display: block; position: relative; z-index: 100; }

.stylish_radio input[type="radio"] { border-radius: 50%; }

.stylish_radio input[type="radio"].radio::after { border-radius: 50%; }

.stylish_radio label { margin-bottom: 0px; font-size: 13px; color: rgb(51, 51, 51); font-weight: 600; }

.style_check input[type="checkbox"] { appearance: none; right: 0px; bottom: 0px; left: 0px; height: 18px; width: 18px; transition: 0.15s ease-out; background: rgb(255, 255, 255); border: 2px solid rgb(5, 107, 195); color: rgb(255, 255, 255); cursor: pointer; display: inline-block; margin-right: 0.8rem; margin-left: 0.8rem; outline: none; position: relative; z-index: 1000; }

.style_check input[type="checkbox"]:hover { background: rgb(5, 107, 195); }

.style_check input[type="checkbox"]:checked { background: rgb(5, 107, 195); }

