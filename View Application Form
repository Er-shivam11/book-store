@charset "utf-8";

@font-face { font-family: Dead_History; src: url("../fonts/Dead_History.ttf"); font-weight: normal; font-style: normal; }

@font-face { font-family: Dead_History_Bold; src: url("../fonts/DeadHistory_Bold.ttf"); font-weight: normal; font-style: normal; }

@font-face { font-family: georgia; src: url("../fonts/Georgia.ttf"); }

@font-face { font-family: georgia_italic; src: url("../fonts/georgia_italic.ttf"); }

body { text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; font: 300 14px / 21px "Open Sans", sans-serif, Helvetica, Arial, sans-serif !important; }

.wrapper { display: block; }

.bottom-wrapper { padding: 10px 0px 5px; }

.footer-container div { display: block !important; }

.footer-wrapper #block-menu-menu-content-menu { padding: 50px 31px; box-sizing: border-box; width: 1180px; margin: 0px auto; display: inline-block; }

.footer-wrapper #block-menu-menu-content-menu .content_menu_title { float: left; width: 230px; padding-right: 10px; }

.footer-wrapper #block-menu-menu-content-menu .content_menu_title h2 { font-size: 384%; color: rgb(83, 83, 83); line-height: 1.1em; }

.footer-wrapper #block-menu-menu-content-menu .content_menu_title .menu-desc { font-weight: 600; color: rgb(122, 122, 122); }

.footer-wrapper #block-menu-menu-content-menu .content { float: right; padding-top: 12px; }

.footer-wrapper #block-menu-menu-content-menu .content { float: right; padding-top: 12px; }

.footer-wrapper #block-menu-menu-secondary-menu { display: block; padding: 0px 15px; float: left; width: 50%; box-sizing: border-box; }

.footer-wrapper .bottom-right #block-block-25 { color: white; padding: 0px 0px 0px 110px; background: url("../image/mygov_qr.png") 0px 0px no-repeat; margin: 0px 0px 0px 20px; line-height: 1.4; }

.footer-wrapper .bottom-right #block-common-utils-developed-by-block { margin-bottom: 0px; float: left; width: 50%; box-sizing: border-box; }

.footer-wrapper .bottom-right #block-common-utils-developed-by-block > .developed { border-left: 1px solid rgb(82, 85, 97); }

.footer-wrapper .bottom-right #block-block-25 .content { padding: 0px; margin: 0px 0px 0px 10px; }

.footer-wrapper .bottom-right #block-block-25 .content a { margin-bottom: 5px; display: inline-block; }

.footer-wrapper .bottom-right #block-block-25 .content span { display: block; }

.bottom-wrapper .footer-container { margin: 0px auto; background: none !important; }

.footer-wrapper #block-menu-menu-secondary-menu ul.menu { display: inline-block; float: none; padding-left: 1px; margin-bottom: 0px; }

.footer-wrapper #block-menu-menu-secondary-menu ul.menu li { color: rgb(127, 128, 128); font-size: 13px; float: left; list-style: outside none none; margin: 0px; padding: 0px 0px 5px; width: 32.5%; }

.footer-wrapper #block-menu-menu-secondary-menu ul.menu li a:hover { color: white; font-size: 13px; text-decoration: none; }

.footer-wrapper #block-menu-menu-secondary-menu ul.menu li:last-child::after { content: ""; }

.footer-wrapper #block-menu-menu-secondary-menu ul.menu li a { color: white; padding: 0px 5px; }

.footer-container .footer_logo { padding-bottom: 40px; padding-left: 60px; padding-top: 20px; text-align: left; width: 591px; }

.footer-container .footer_logo li { float: left; margin-right: 50px; }

.sub-sites { text-align: center; position: relative; padding: 10px 15px 0px; }

.sub-sites li { padding: 0px 10px; border-left: 1px solid rgb(107, 108, 111); display: inline-block; margin-bottom: 10px; list-style: none; }

.sub-sites li:first-child, .footer-logo li:first-child { border: none; }

.sub-sites::after { background: linear-gradient(to right, rgba(6, 47, 60, 0.01) 0%, rgba(45, 75, 100, 0.98) 50%, rgb(44, 74, 99) 51%, rgba(6, 47, 60, 0.01) 100%) 0px 0px repeat scroll rgba(0, 0, 0, 0); content: ""; display: block; height: 1px; position: absolute; right: 0px; top: 0px; width: 100%; }

.footer-logo { padding: 7px 15px 0px; text-align: center; border-bottom: 1px solid rgb(78, 78, 78); }

.footer-logo ul { padding: 2px 0px; margin-bottom: 2px; }

.footer-logo li { border-left: 1px solid rgb(78, 78, 78); display: inline-block; padding: 0px 10px; margin-bottom: 7px; vertical-align: middle; list-style: none; box-sizing: border-box; }

@media (max-width: 640px) {
  .sub-sites li, .sub-sites li:first-child { padding: 10px; border: 1px solid rgb(44, 74, 99); }
  .sub-sites { padding: 15px 10px 5px; }
}

@media (max-width: 567px) {
  .footer-logo { overflow: hidden; padding: 10px 5px 0px; }
  .footer-logo li { width: 50%; border-left: none; padding: 0px; float: left; margin: 10px 0px; }
  .footer-logo li:nth-child(2n+2) { border-left: 1px solid rgb(40, 40, 42); }
}

.progressPopup { position: fixed; vertical-align: middle; text-align: center; z-index: 999999; opacity: 5; top: 0px; left: 0px; height: 100%; width: 100%; background-color: white; }

#logo-svg { height: 70px; width: 100%; }

.footer-section { overflow-x: hidden; }

footer { overflow-y: hidden; }

.footer-logo { max-width: 100%; margin: 0px auto; }

.footer-logo p { font-size: 17px; text-align: center; text-transform: uppercase; letter-spacing: 0.4em; padding-left: 16px; padding-top: 14px; }

.footer-social { padding: 51px 0px 100px; margin: 0px auto; text-align: center; }

.footer-social a { margin: 0px 10px; height: 35px; width: 35px; border-radius: 50%; line-height: 37px; font-size: 16px; }

.go-top { position: relative; overflow: visible; }

.go-top div { position: absolute; }

.circle1, .circle2 { height: 40px; width: 80px; left: 50%; bottom: 0px; z-index: 3; border-bottom-left-radius: 80px; border-bottom-right-radius: 80px; transform: translateX(0px); }

.circle1 { margin-left: -90.4286px; transform: translateX(60px); }

.circle1::after { content: ""; position: absolute; height: 40px; width: 240px; right: 40px; bottom: 0px; }

.circle2 { margin-left: 11.4286px; transform: translateX(-60px); }

